{
	"name": "videoteca-for-mux",
	"version": "1.0.0",
	"description": "Upload, organize, search and embed Mux videos from the WordPress admin.",
	"author": "Eurico Sá Fernandes",
	"license": "GPL-2.0-or-later",
	"private": true,
	"files": [
		"build",
		"includes",
		"license.txt",
		"src",
		"tools",
		"package.json",
		"webpack.config.js",
		"readme.txt",
		"uninstall.php",
		"videoteca-for-mux.php"
	],
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"format": "wp-scripts format src",
		"plugin-zip": "npm run build && wp-scripts plugin-zip && zip -dq videoteca-for-mux.zip videoteca-for-mux/readme.md"
	},
	"dependencies": {
		"@mux/mux-player": "^3.14.1",
		"@mux/upchunk": "^3.5.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/date": "^6.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/url": "^5.0.0"
	},
	"devDependencies": {
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^35.0.0"
	}
}
